{
  "Auth": {
    "Enabled": true,
    "Authority": "http://keycloak:8080/realms/webshop",
    "Audience": "webshop-api",
    "RequireHttpsMetadata": false,
    "ValidIssuers": [
      "http://localhost:8080/realms/webshop"
    ]
  },
  "ReverseProxy": {
    "Clusters": {
      "catalog": {
        "Destinations": {
          "d1": {
            "Address": "http://catalog-api:8080/"
          }
        }
      },
      "basket": {
        "Destinations": {
          "d1": {
            "Address": "http://basket-api:8080/"
          }
        }
      },
      "ordering": {
        "Destinations": {
          "d1": {
            "Address": "http://ordering-api:8080/"
          }
        }
      }
    }
  }
}
