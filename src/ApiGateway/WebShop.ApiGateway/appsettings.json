        "Match": {
          "Path": "/api/v1/basket/{**catch-all}"
        }
      },
      "ordering": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/orders/{**catch-all}"
        }
      },
      "orders": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/orders/{**catch-all}"
        }
      },
      "payment-methods": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/payment-methods"
        }
      },
      "payments": {
        "ClusterId": "ordering",
        "Match": {
          "Path": "/api/v1/payments/{**catch-all}"
        }
      },
      "payments_legacy": {
        "ClusterId": "ordering",
