@inherits LayoutComponentBase
@implements IDisposable
@inject CartState Cart
@inject LanguageState Lang
@inject NavigationManager Nav

<header class="header" @onclick="CloseMenus">
    <div class="container header-inner">
        <a class="logo" href="/">GameShop</a>

        <nav class="nav" aria-label="Primary">
            <NavLink href="/" Match="NavLinkMatch.All">@Lang.NavHome</NavLink>
            <NavLink href="/about">@Lang.NavAbout</NavLink>
            <NavLink href="/diamonds">@Lang.NavDiamonds</NavLink>
            <NavLink href="/subscription">@Lang.NavSubscription</NavLink>
            <NavLink href="/help">@Lang.NavHelp</NavLink>
        </nav>

        <div class="header-right">
            <div class="menu desktop-only" @onclick:stopPropagation="true">
                <button class="icon-btn" type="button" aria-label="Language" @onclick="ToggleLangMenu">
                    <span class="icon" aria-hidden="true">@((MarkupString)Icons.Globe)</span>
                    <span>@Lang.Code</span>
                    <span class="icon" aria-hidden="true">@((MarkupString)Icons.ChevronDown)</span>
                </button>

                @if (LangMenuOpen)
                {
                    <div class="menu-panel" role="menu" aria-label="Language menu">
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Ru)">
                            <span>RU</span><span class="muted">Русский</span>
                        </button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.En)">
                            <span>EN</span><span class="muted">English</span>
                        </button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.De)">
                            <span>DE</span><span class="muted">Deutsch</span>
                        </button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Fr)">
                            <span>FR</span><span class="muted">Français</span>
                        </button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Es)">
                            <span>ES</span><span class="muted">Español</span>
                        </button>
                    </div>
                }
            </div>

            <div class="menu mobile-only" @onclick:stopPropagation="true">
                <button class="icon-btn" type="button" aria-label="Language" @onclick="ToggleLangMenu">
                    <span class="icon" aria-hidden="true">@((MarkupString)Icons.Globe)</span>
                </button>
                @if (LangMenuOpen)
                {
                    <div class="menu-panel" role="menu" aria-label="Language menu">
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Ru)"><span>RU</span><span class="muted">Русский</span></button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.En)"><span>EN</span><span class="muted">English</span></button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.De)"><span>DE</span><span class="muted">Deutsch</span></button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Fr)"><span>FR</span><span class="muted">Français</span></button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Es)"><span>ES</span><span class="muted">Español</span></button>
                    </div>
                }
            </div>

            <button class="icon-btn cart" type="button" aria-label="Cart" @onclick="GoToCart">
                <span class="icon" aria-hidden="true">@((MarkupString)Icons.Cart)</span>
                @if (Cart.Count > 0)
                {
                    <span class="cart-badge">@Cart.Count</span>
                }
            </button>

            <button class="icon-btn mobile-only" type="button" aria-label="Menu" @onclick="ToggleMobileNav">
                <span class="icon" aria-hidden="true">@((MarkupString)Icons.Hamburger)</span>
            </button>
        </div>
    </div>

    <div class="mobile-nav @(MobileNavOpen ? "open" : "")" @onclick="CloseMobileNav">
        <NavLink href="/" Match="NavLinkMatch.All">@Lang.NavHome</NavLink>
        <NavLink href="/about">@Lang.NavAbout</NavLink>
        <NavLink href="/diamonds">@Lang.NavDiamonds</NavLink>
        <NavLink href="/subscription">@Lang.NavSubscription</NavLink>
        <NavLink href="/help">@Lang.NavHelp</NavLink>
    </div>
</header>

<main>
    @Body
</main>

@code {
    private bool MobileNavOpen;
    private bool LangMenuOpen;

    protected override void OnInitialized()
    {
        Cart.Changed += OnCartChanged;
        Lang.Changed += OnLangChanged;
        Nav.LocationChanged += OnLocationChanged;
        base.OnInitialized();
    }

    private void OnCartChanged() => InvokeAsync(StateHasChanged);
    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        MobileNavOpen = false;
        LangMenuOpen = false;
    }

    private void ToggleMobileNav() => MobileNavOpen = !MobileNavOpen;

    private void CloseMobileNav() => MobileNavOpen = false;

    private void ToggleLangMenu() => LangMenuOpen = !LangMenuOpen;

    private void SetLang(LanguageState.Language lang)
    {
        Lang.Set(lang);
        LangMenuOpen = false;
    }

    private void GoToCart() => Nav.NavigateTo("/cart");

    private void CloseMenus()
    {
        LangMenuOpen = false;
    }

    public void Dispose()
    {
        Cart.Changed -= OnCartChanged;
        Lang.Changed -= OnLangChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private static class Icons
    {
        public const string Globe =
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z' stroke='currentColor' stroke-width='2'/><path d='M3.6 9h16.8M3.6 15h16.8' stroke='currentColor' stroke-width='2' stroke-linecap='round'/><path d='M12 3c2.6 2.7 4 5.8 4 9s-1.4 6.3-4 9c-2.6-2.7-4-5.8-4-9s1.4-6.3 4-9Z' stroke='currentColor' stroke-width='2'/></svg>";

        public const string ChevronDown =
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M6 9l6 6 6-6' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>";

        public const string Cart =
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M6 6h15l-2 8H7L6 6Z' stroke='currentColor' stroke-width='2' stroke-linejoin='round'/><path d='M6 6 5 3H2' stroke='currentColor' stroke-width='2' stroke-linecap='round'/><path d='M8 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM18 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z' fill='currentColor'/></svg>";

        public const string Hamburger =
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M4 6h16M4 12h16M4 18h16' stroke='currentColor' stroke-width='2' stroke-linecap='round'/></svg>";
    }
}
