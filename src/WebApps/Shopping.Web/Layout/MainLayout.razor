@inherits LayoutComponentBase
@implements IDisposable
@inject CartState Cart
@inject LanguageState Lang
@inject NavigationManager Nav
@inject HttpClient Http
@inject IConfiguration Config
@inject PaymentService Payments

<header class="header" @onclick="CloseMenus">
    <div class="container header-inner">
        <a class="logo" href="/">GameShop</a>

        <nav class="nav" aria-label="Primary">
            <NavLink href="/" Match="NavLinkMatch.All">@Lang.NavHome</NavLink>
            <NavLink href="/about">@Lang.NavAbout</NavLink>
            <NavLink href="/diamonds">@Lang.NavDiamonds</NavLink>
            <NavLink href="/subscription">@Lang.NavSubscription</NavLink>
            <NavLink href="/help">@Lang.NavHelp</NavLink>
        </nav>

        <div class="header-right">
            <div class="menu desktop-only" @onclick:stopPropagation="true">
                <button class="icon-btn" type="button" aria-label="Language" @onclick="ToggleLangMenu">
                    <span class="icon" aria-hidden="true">@((MarkupString)Icons.Globe)</span>
                    <span>@Lang.Code</span>
                    <span class="icon" aria-hidden="true">@((MarkupString)Icons.ChevronDown)</span>
                </button>

                @if (LangMenuOpen)
                {
                    <div class="menu-panel" role="menu" aria-label="Language menu">
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Ru)">
                            <span>RU</span><span class="muted">Русский</span>
                        </button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.En)">
                            <span>EN</span><span class="muted">English</span>
                        </button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.De)">
                            <span>DE</span><span class="muted">Deutsch</span>
                        </button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Fr)">
                            <span>FR</span><span class="muted">Français</span>
                        </button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Es)">
                            <span>ES</span><span class="muted">Español</span>
                        </button>
                    </div>
                }
            </div>

            <div class="menu mobile-only" @onclick:stopPropagation="true">
                <button class="icon-btn" type="button" aria-label="Language" @onclick="ToggleLangMenu">
                    <span class="icon" aria-hidden="true">@((MarkupString)Icons.Globe)</span>
                </button>
                @if (LangMenuOpen)
                {
                    <div class="menu-panel" role="menu" aria-label="Language menu">
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Ru)"><span>RU</span><span class="muted">Русский</span></button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.En)"><span>EN</span><span class="muted">English</span></button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.De)"><span>DE</span><span class="muted">Deutsch</span></button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Fr)"><span>FR</span><span class="muted">Français</span></button>
                        <button class="menu-item" type="button" @onclick="() => SetLang(LanguageState.Language.Es)"><span>ES</span><span class="muted">Español</span></button>
                    </div>
                }
            </div>

            <button class="icon-btn cart @(CartBump ? "bump" : "")" type="button" aria-label="Cart" @onclick="OpenCart" @onclick:stopPropagation="true">
                <span class="icon" aria-hidden="true">@((MarkupString)Icons.Cart)</span>
                @if (Cart.Count > 0)
                {
                    <span class="cart-badge">@Cart.Count</span>
                }
            </button>

            <button class="icon-btn mobile-only" type="button" aria-label="Menu" @onclick="ToggleMobileNav">
                <span class="icon" aria-hidden="true">@((MarkupString)Icons.Hamburger)</span>
            </button>
        </div>
    </div>

    <div class="mobile-nav @(MobileNavOpen ? "open" : "")" @onclick="CloseMobileNav">
        <NavLink href="/" Match="NavLinkMatch.All">@Lang.NavHome</NavLink>
        <NavLink href="/about">@Lang.NavAbout</NavLink>
        <NavLink href="/diamonds">@Lang.NavDiamonds</NavLink>
        <NavLink href="/subscription">@Lang.NavSubscription</NavLink>
        <NavLink href="/help">@Lang.NavHelp</NavLink>
    </div>
</header>

<main>
    <CascadingValue Value="Lang.Current" @key="Lang.Current">
        @Body
    </CascadingValue>
</main>

<div class="cart-overlay @(CartOpen ? "open" : "")" @onclick="CloseCart"></div>
<aside class="cart-drawer @(CartOpen ? "open" : "")" aria-label="Cart drawer" @onclick:stopPropagation="true">
    <div class="cart-drawer-header">
        <div class="cart-drawer-title">@Lang.T("Корзина", "Cart", "Warenkorb", "Panier", "Carrito")</div>
        <button class="cart-close" type="button" aria-label="Close" @onclick="CloseCart">✕</button>
    </div>

    @if (Cart.Lines.Count == 0)
    {
        <div class="cart-empty">
            <div class="cart-empty-ill">ilExample Game Studiotion</div>
            <div class="cart-empty-title">@Lang.T("Корзина пуста", "Cart is empty", "Warenkorb leer", "Panier vide", "Carrito vacío")</div>
            <div class="cart-empty-sub">@Lang.T("Добавьте товары для оформления заказа", "Add items to place an order", "Füge Artikel hinzu, um zu bestellen", "Ajoutez des articles pour commander", "Añade productos para realizar el pedido")</div>
        </div>
    }
    else
    {
        <div class="cart-items">
            @foreach (var line in Cart.Lines)
            {
                <div class="cart-row">
                    <div class="cart-img">img</div>
                    <div class="cart-row-main">
                        <div class="cart-row-top">
                            <div class="cart-row-name">@line.Title</div>
                            <button class="cart-row-remove" type="button" aria-label="Remove" @onclick="() => Cart.Remove(line.Sku)">✕</button>
                        </div>
                        <div class="cart-row-bottom">
                            <div class="qty">
                                <button class="qty-btn" type="button" @onclick="() => Cart.Decrement(line.Sku)">−</button>
                                <div class="qty-num">@line.Quantity</div>
                                <button class="qty-btn" type="button" @onclick="() => Cart.Increment(line.Sku)">+</button>
                            </div>
                            <div class="cart-row-price">@FormatMoney(line.UnitPrice * line.Quantity)</div>
                        </div>
                    </div>
                </div>
            }
        </div>

	        <div class="cart-promo">
	            <div class="cart-promo-label">@Lang.T("Промокод", "Promo code", "Promocode", "Code promo", "Código promo")</div>
	            <div class="cart-promo-row">
	                <input class="cart-input" @bind="PromoCode" placeholder="@(Lang.T("Введите код", "Enter code", "Code eingeben", "Saisir le code", "Introduce el código"))" />
	                <button class="cart-apply" type="button" disabled="@PromoBusy" @onclick="ApplyPromo">@Lang.T("Применить", "Apply", "Anwenden", "Appliquer", "Aplicar")</button>
	            </div>
	            @if (!string.IsNullOrWhiteSpace(PromoMessage))
	            {
	                <div class="muted" style="margin-top: 10px;">@PromoMessage</div>
	            }
        </div>

        <div class="cart-customer">
            <div class="cart-promo-label">@Lang.T("Данные игрока", "Player details", "Spielerdaten", "Informations du joueur", "Datos del jugador")</div>
            <div class="cart-customer-grid">
                <input class="cart-input" @bind="PlayerId" placeholder="@(Lang.T("ID игрока", "Player ID", "Spieler-ID", "ID joueur", "ID de jugador"))" />
                <input class="cart-input" @bind="PlayerName" placeholder="@(Lang.T("Имя", "Name", "Name", "Nom", "Nombre"))" />
                <input class="cart-input" @bind="PlayerEmail" placeholder="Email" />
            </div>

            <label class="cart-promo-label cart-payment-label" for="cart-payment-select">@Lang.T("Способ оплаты", "Payment method", "Zahlungsmethode", "Methode de paiement", "Metodo de pago")</label>
            <select id="cart-payment-select" class="cart-input pay-select" @bind="SelectedPaymentMethod" @bind:after="OnPaymentMethodChanged">
                <option value="">@Lang.T("Выберите способ оплаты", "Select payment method", "Zahlungsmethode wählen", "Choisir le mode de paiement", "Elegir método de pago")</option>
                @foreach (var m in _paymentMethods)
                {
                    <option value="@m.Code">@m.Name</option>
                }
            </select>
            @if (PaymentMethodsLoadFailed)
            {
                <div class="muted" style="margin-top: 10px;">@Lang.T(
                    "Не удалось загрузить способы оплаты. Проверьте, что сервис заказов доступен.",
                    "Could not load payment methods. Make sure the ordering service is available.",
                    "Zahlungsmethoden konnten nicht geladen werden. Prüfe, ob der Bestellservice erreichbar ist.",
                    "Impossible de charger les moyens de paiement. Vérifiez que le service de commande est disponible.",
                    "No se pudieron cargar los métodos de pago. Comprueba que el servicio de pedidos esté disponible."
                )</div>
            }

            @if (!CanCheckout)
            {
                <div class="muted" style="margin-top: 10px;">@CheckoutRequirementsText</div>
            }
        </div>

	        <div class="cart-footer">
	            <div class="cart-total">
	                <div class="muted">@Lang.T("Итого:", "Total:", "Summe:", "Total :", "Total:")</div>
	                <div class="cart-total-amount">@FormatMoney(TotalWithPromo)</div>
	            </div>
	            @if (PromoDiscountAmount > 0)
	            {
	                <div class="muted" style="margin-top: 8px;">
	                    @Lang.T("Скидка:", "Discount:", "Rabatt:", "Remise :", "Descuento:") @FormatMoney(PromoDiscountAmount)
	                </div>
	            }
	            <button class="cart-checkout" type="button" disabled="@(!CanCheckout)" @onclick="Checkout">@Lang.T("Оформить заказ", "Checkout", "Bestellen", "Commander", "Finalizar")</button>
	            @if (!string.IsNullOrWhiteSpace(CheckoutMessage))
	            {
	                <div class="muted" style="margin-top: 10px;">@CheckoutMessage</div>
            }
            <button class="cart-clear" type="button" @onclick="Cart.Clear">@Lang.T("Очистить корзину", "Clear cart", "Warenkorb leeren", "Vider le panier", "Vaciar carrito")</button>
        </div>
    }
</aside>

@code {
	    private bool MobileNavOpen;
	    private bool LangMenuOpen;
	    private bool CartOpen;
	    private bool CartBump;
	    private CancellationTokenSource? CartBumpCts;
	    private string PromoCode = string.Empty;
	    private string? PromoMessage;
	    private string? AppliedPromoCode;
	    private decimal PromoDiscountAmount;
	    private bool PromoBusy;
	    private string PlayerId = string.Empty;
	    private string PlayerName = string.Empty;
	    private string PlayerEmail = string.Empty;
	    private string SelectedPaymentMethod = string.Empty;
	    private string? CheckoutMessage;
	    private IReadOnlyList<PaymentMethodInfo> _paymentMethods = [];
	    private bool PaymentMethodsLoadFailed;

    private bool CanCheckout =>
        Cart.Lines.Count > 0 &&
        !string.IsNullOrWhiteSpace(PlayerId) &&
        !string.IsNullOrWhiteSpace(PlayerName) &&
        (string.IsNullOrWhiteSpace(PlayerEmail) || IsValidEmail(PlayerEmail)) &&
        !string.IsNullOrWhiteSpace(SelectedPaymentMethod);

    private string CheckoutRequirementsText =>
        Lang.T(
            "Заполните ID игрока, имя и выберите способ оплаты. Email — по желанию.",
            "Fill in player ID, name, and select a payment method. Email is optional.",
            "Fülle Spieler-ID und Name aus und wähle eine Zahlungsmethode. E-Mail ist optional.",
            "Renseignez l'ID joueur, le nom et choisissez un mode de paiement. L'email est facultatif.",
            "Completa ID de jugador, nombre y elige un metodo de pago. El email es opcional.");

	    protected override void OnInitialized()
	    {
	        Cart.Changed += OnCartChanged;
	        Lang.Changed += OnLangChanged;
        Nav.LocationChanged += OnLocationChanged;
        base.OnInitialized();
    }

	    protected override async Task OnInitializedAsync()
	    {
	        await LoadPaymentMethodsAsync();
	    }

	    private async Task LoadPaymentMethodsAsync()
	    {
	        var list = await Payments.GetPaymentMethodsAsync();
	        if (list is null || list.Count == 0)
	        {
	            _paymentMethods = [];
	            PaymentMethodsLoadFailed = true;
	        }
	        else
	        {
	            _paymentMethods = list;
	            PaymentMethodsLoadFailed = false;
	        }

	        NormalizePaymentSelection();
	    }

	    private void NormalizePaymentSelection()
	    {
	        if (string.IsNullOrWhiteSpace(SelectedPaymentMethod))
	        {
	            return;
	        }

	        if (!_paymentMethods.Any(m => string.Equals(m.Code, SelectedPaymentMethod, StringComparison.OrdinalIgnoreCase)))
	        {
	            SelectedPaymentMethod = string.Empty;
	        }
	    }

	    private async void OnCartChanged()
	    {
	        CartBumpCts?.Cancel();
	        CartBumpCts = new CancellationTokenSource();
	        var token = CartBumpCts.Token;

        CartBump = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(220, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        CartBump = false;

        if (!string.IsNullOrWhiteSpace(AppliedPromoCode))
        {
            _ = ApplyPromo(AppliedPromoCode, isSilent: true);
        }

        await InvokeAsync(StateHasChanged);
    }
    private void OnLangChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        MobileNavOpen = false;
        LangMenuOpen = false;
    }

    private void ToggleMobileNav() => MobileNavOpen = !MobileNavOpen;

    private void CloseMobileNav() => MobileNavOpen = false;

    private void ToggleLangMenu() => LangMenuOpen = !LangMenuOpen;

    private void SetLang(LanguageState.Language lang)
    {
        Lang.Set(lang);
        LangMenuOpen = false;
    }

    private void OpenCart()
    {
        CartOpen = true;
        LangMenuOpen = false;
        MobileNavOpen = false;
    }

    private void CloseCart() => CartOpen = false;

	    private async Task ApplyPromo() => await ApplyPromo(PromoCode);

	    private async Task ApplyPromo(string? code = null, bool isSilent = false)
	    {
	        var targetCode = (code ?? PromoCode)?.Trim() ?? string.Empty;

	        if (!isSilent)
	        {
	            PromoMessage = null;
	            AppliedPromoCode = null;
	            PromoDiscountAmount = 0m;
	        }

	        if (string.IsNullOrWhiteSpace(targetCode))
	        {
	            if (!isSilent)
	            {
	                PromoMessage = Lang.T("Введите промокод.", "Enter a promo code.", "Promocode eingeben.", "Saisissez un code promo.", "Introduce un código promo.");
	                AppliedPromoCode = null;
	                PromoDiscountAmount = 0m;
	            }
	            return;
	        }

	        var lines = new List<ApplyPromoLine>(Cart.Lines.Count);
	        foreach (var line in Cart.Lines)
	        {
	            if (!TryParseProductId(line.Sku, out var productId))
	            {
	                if (!isSilent)
	                {
	                    PromoMessage = Lang.T(
	                        "Товары в корзине нужно обновить (перезагрузите страницу) и применить промокод заново.",
	                        "Please refresh the page and apply the promo code again.",
	                        "Bitte Seite neu laden und den Code erneut anwenden.",
	                        "Veuillez recharger la page et réappliquer le code.",
	                        "Recarga la página y aplica el código de nuevo.");
	                    AppliedPromoCode = null;
	                    PromoDiscountAmount = 0m;
	                }
	                return;
	            }

	            lines.Add(new ApplyPromoLine(productId, line.Quantity));
	        }

	        PromoBusy = true;
	        try
	        {
	            var request = new ApplyPromoRequest(targetCode, lines);
	            using var response = await Http.PostAsJsonAsync(PromoApplyUrl, request);
	            if (!response.IsSuccessStatusCode)
	            {
	                if (!isSilent)
	                {
	                    PromoMessage = Lang.T(
	                        "Не удалось применить промокод. Попробуйте позже.",
	                        "Could not apply promo code. Please try again later.",
	                        "Promocode konnte nicht angewendet werden. Bitte später erneut versuchen.",
	                        "Impossible d’appliquer le code promo. Réessayez plus tard.",
	                        "No se pudo aplicar el código. Inténtalo de nuevo más tarde.");
	                }
	                AppliedPromoCode = null;
	                PromoDiscountAmount = 0m;
	                return;
	            }

	            var result = await response.Content.ReadFromJsonAsync<ApplyPromoResponse>();
	            if (result is null)
	            {
	                if (!isSilent)
	                {
	                    PromoMessage = Lang.T(
	                        "Не удалось применить промокод. Попробуйте позже.",
	                        "Could not apply promo code. Please try again later.",
	                        "Promocode konnte nicht angewendet werden. Bitte später erneut versuchen.",
	                        "Impossible d’appliquer le code promo. Réessayez plus tard.",
	                        "No se pudo aplicar el código. Inténtalo de nuevo más tarde.");
	                }
	                AppliedPromoCode = null;
	                PromoDiscountAmount = 0m;
	                return;
	            }

	            if (!result.IsValid)
	            {
	                if (!isSilent)
	                {
	                    PromoMessage = result.Error ?? Lang.T("Промокод недействителен.", "Invalid promo code.", "Ungültiger Code.", "Code invalide.", "Código inválido.");
	                }
	                AppliedPromoCode = null;
	                PromoDiscountAmount = 0m;
	                return;
	            }

	            AppliedPromoCode = targetCode;
	            PromoDiscountAmount = Math.Max(0m, result.DiscountAmount);

	            if (!isSilent)
	            {
	                PromoMessage = Lang.T(
	                    "Промокод применён.",
	                    "Promo code applied.",
	                    "Code angewendet.",
	                    "Code appliqué.",
	                    "Código aplicado.");
	            }
	        }
	        catch
	        {
	            if (!isSilent)
	            {
	                PromoMessage = Lang.T(
	                    "Не удалось применить промокод. Попробуйте позже.",
	                    "Could not apply promo code. Please try again later.",
	                    "Promocode konnte nicht angewendet werden. Bitte später erneut versuchen.",
	                    "Impossible d’appliquer le code promo. Réessayez plus tard.",
	                    "No se pudo aplicar el código. Inténtalo de nuevo más tarde.");
	            }
	            AppliedPromoCode = null;
	            PromoDiscountAmount = 0m;
	        }
	        finally
	        {
	            PromoBusy = false;
	            StateHasChanged();
	        }
	    }

    private void OnPaymentMethodChanged() => CheckoutMessage = null;

    private void Checkout()
    {
        if (!CanCheckout)
        {
            return;
        }

        CheckoutMessage = Lang.T(
            "Данные для заказа заполнены. Далее можно отправлять запрос на оплату.",
            "Checkout details are complete. You can now send the payment request.",
            "Die Checkout-Daten sind vollständig. Der Zahlungsrequest kann jetzt gesendet werden.",
            "Les informations de commande sont completees. Vous pouvez maintenant envoyer la demande de paiement.",
            "Los datos de checkout estan completos. Ahora puedes enviar la solicitud de pago.");
    }

    private static bool IsValidEmail(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var email = value.Trim();
        return email.Contains('@') && email.Contains('.');
    }

    private void CloseMenus()
    {
        LangMenuOpen = false;
    }

	    private decimal TotalWithPromo => Math.Max(0m, Cart.Total - PromoDiscountAmount);

	    private string PromoApplyUrl
	    {
	        get
	        {
	            var baseUrl = Config["ApiBaseUrl"]?.Trim();
	            return string.IsNullOrWhiteSpace(baseUrl)
	                ? "/api/v1/promocodes/apply"
	                : $"{baseUrl.TrimEnd('/')}/api/v1/promocodes/apply";
	        }
	    }

	    private static bool TryParseProductId(string sku, out Guid productId)
	    {
	        productId = default;
	        if (string.IsNullOrWhiteSpace(sku))
	        {
	            return false;
	        }

	        var idx = sku.IndexOf(':', StringComparison.Ordinal);
	        if (idx < 0 || idx == sku.Length - 1)
	        {
	            return false;
	        }

	        var idText = sku[(idx + 1)..].Trim();
	        return Guid.TryParse(idText, out productId);
	    }

	    private static string FormatMoney(decimal value) => $"€{value:0.00}";

	    private sealed record ApplyPromoRequest(string Code, IReadOnlyList<ApplyPromoLine> Items);
	    private sealed record ApplyPromoLine(Guid ProductId, int Quantity);
	    private sealed record ApplyPromoResponse(bool IsValid, string? Error, decimal Subtotal, decimal DiscountAmount, decimal Total, string Currency);

    public void Dispose()
    {
        Cart.Changed -= OnCartChanged;
        Lang.Changed -= OnLangChanged;
        Nav.LocationChanged -= OnLocationChanged;
        CartBumpCts?.Cancel();
    }

    private static class Icons
    {
        public const string Globe =
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z' stroke='currentColor' stroke-width='2'/><path d='M3.6 9h16.8M3.6 15h16.8' stroke='currentColor' stroke-width='2' stroke-linecap='round'/><path d='M12 3c2.6 2.7 4 5.8 4 9s-1.4 6.3-4 9c-2.6-2.7-4-5.8-4-9s1.4-6.3 4-9Z' stroke='currentColor' stroke-width='2'/></svg>";

        public const string ChevronDown =
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M6 9l6 6 6-6' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>";

        public const string Cart =
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M6 6h15l-2 8H7L6 6Z' stroke='currentColor' stroke-width='2' stroke-linejoin='round'/><path d='M6 6 5 3H2' stroke='currentColor' stroke-width='2' stroke-linecap='round'/><path d='M8 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM18 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z' fill='currentColor'/></svg>";

        public const string Hamburger =
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M4 6h16M4 12h16M4 18h16' stroke='currentColor' stroke-width='2' stroke-linecap='round'/></svg>";
    }
}
