@page "/diamonds"
@inject CartState Cart
@inject LanguageState Lang
@inject HttpClient Http
@inject IConfiguration Config

<PageTitle>GameShop — @Lang.T("Алмазы", "Diamonds", "Diamanten", "Diamants", "Diamantes")</PageTitle>

<section class="page-pad" style="padding-bottom: 60px;">
    <div class="container">
        <div class="centered">
            <h1>@Lang.T("Алмазы", "Diamonds", "Diamanten", "Diamants", "Diamantes")</h1>
            <p class="muted" style="margin: 0 auto 48px; max-width: 680px;">
                @Lang.T(
                    "Выберите пакет алмазов и добавьте в корзину. Начисление обычно занимает несколько минут после подтверждения оплаты.",
                    "Choose a diamond pack and add it to your cart. Delivery usually takes a few minutes after payment is confirmed.",
                    "Wähle ein Diamanten‑Paket und lege es in den Warenkorb. Die Lieferung dauert обычно nur wenige Minuten nach Zahlungsbestätigung.",
                    "Choisissez un pack de diamants et ajoutez‑le au panier. La livraison prend généralement quelques minutes après confirmation du paiement.",
                    "Elige un paquete de diamantes y añádelo al carrito. La entrega suele tardar unos minutos tras confirmar el pago."
                )
            </p>
        </div>

        <div class="grid diamonds">
            @foreach (var pack in Packs)
            {
                <div class="card diamond-card">
                    @if (!string.IsNullOrWhiteSpace(GetBadgeText(pack.BadgeKey)))
                    {
                        <div class="card-badge @(pack.BadgeKind == "gold" ? "badge-gold" : "badge-purple")">@GetBadgeText(pack.BadgeKey)</div>
                    }

                    <div class="img-square">image</div>
                    <div class="diamond-amount">@FormatDiamondAmount(pack.Diamonds)</div>
                    <div class="diamond-price">@pack.PriceLabel</div>

                    <button class="btn btn-primary btn-full" type="button" @onclick="() => AddToCart(pack)">
                        @Lang.T("В корзину", "Add to cart", "In den Warenkorb", "Ajouter au panier", "Añadir al carrito")
                    </button>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private IReadOnlyList<DiamondPack> Packs => _packs;
    private IReadOnlyList<DiamondPack> _packs = [];

    protected override async Task OnInitializedAsync()
    {
        _packs = await LoadPacksAsync();
    }

    private void AddToCart(DiamondPack pack)
    {
        var amountLabel = FormatDiamondAmount(pack.Diamonds);
        Cart.AddItem($"diamonds:{pack.Diamonds}", amountLabel, pack.PriceValue, 1);
    }

    private async Task<IReadOnlyList<DiamondPack>> LoadPacksAsync()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<IReadOnlyList<CatalogItemDto>>(CatalogItemsUrl);
            if (items is null)
            {
                return [];
            }

            return items
                .Where(item => string.Equals(item.Type, "Currency", StringComparison.OrdinalIgnoreCase) && item.IsActive)
                .Select(MapFromCatalog)
                .Where(pack => pack is not null)
                .Select(pack => pack!)
                .OrderBy(pack => pack.Diamonds)
                .ToList();
        }
        catch
        {
            return [];
        }
    }

    private string CatalogItemsUrl
    {
        get
        {
            var baseUrl = Config["ApiBaseUrl"]?.Trim();
            return string.IsNullOrWhiteSpace(baseUrl)
                ? "/api/v1/catalog/items"
                : $"{baseUrl.TrimEnd('/')}/api/v1/catalog/items";
        }
    }

    private static DiamondPack? MapFromCatalog(CatalogItemDto item)
    {
        if (!item.Metadata.TryGetValue("diamonds", out var diamondsText) ||
            !int.TryParse(diamondsText, out var diamonds))
        {
            return null;
        }

        return new DiamondPack(
            diamonds,
            item.Price,
            $"€{item.Price:0.00}",
            GetBadgeKey(diamonds),
            GetBadgeKind(diamonds));
    }

    private string FormatDiamondAmount(int diamonds) =>
        string.Format(
            Lang.T("{0} алмазов", "{0} diamonds", "{0} Diamanten", "{0} diamants", "{0} diamantes"),
            diamonds);

    private string? GetBadgeText(string? badgeKey) => badgeKey switch
    {
        "best" => Lang.T("Выгодно", "Best value", "Bestes Angebot", "Meilleure offre", "Mejor oferta"),
        "top" => Lang.T("Топ", "Top", "Top", "Top", "Top"),
        "hot" => "Hot",
        "mega" => "Mega",
        _ => null
    };

    private static string? GetBadgeKey(int diamonds) => diamonds switch
    {
        350 => "best",
        2000 => "top",
        9000 => "hot",
        25000 => "mega",
        _ => null
    };

    private static string? GetBadgeKind(int diamonds) => diamonds switch
    {
        2000 or 25000 => "gold",
        350 or 9000 => "purple",
        _ => null
    };

    private sealed record DiamondPack(int Diamonds, decimal PriceValue, string PriceLabel, string? BadgeKey, string? BadgeKind);

    private sealed record CatalogItemDto(
        Guid Id,
        string Title,
        string Description,
        string Type,
        decimal Price,
        string Currency,
        bool IsActive,
        Dictionary<string, string> Metadata,
        string? ImageUrl);
}
