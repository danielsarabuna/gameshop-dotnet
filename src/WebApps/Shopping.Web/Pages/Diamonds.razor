@page "/diamonds"
@inject CartState Cart
@inject LanguageState Lang

<PageTitle>GameShop — @Lang.T("Алмазы", "Diamonds", "Diamanten", "Diamants", "Diamantes")</PageTitle>

<section class="page-pad" style="padding-bottom: 60px;">
    <div class="container">
        <div class="centered">
            <h1>@Lang.T("Алмазы", "Diamonds", "Diamanten", "Diamants", "Diamantes")</h1>
            <p class="muted" style="margin: 0 auto 48px; max-width: 680px;">
                @Lang.T(
                    "Выберите пакет алмазов и добавьте в корзину. Начисление обычно занимает несколько минут после подтверждения оплаты.",
                    "Choose a diamond pack and add it to your cart. Delivery usually takes a few minutes after payment is confirmed.",
                    "Wähle ein Diamanten‑Paket und lege es in den Warenkorb. Die Lieferung dauert обычно nur wenige Minuten nach Zahlungsbestätigung.",
                    "Choisissez un pack de diamants et ajoutez‑le au panier. La livraison prend généralement quelques minutes après confirmation du paiement.",
                    "Elige un paquete de diamantes y añádelo al carrito. La entrega suele tardar unos minutos tras confirmar el pago."
                )
            </p>
        </div>

        <div class="grid diamonds">
            @foreach (var pack in Packs)
            {
                <div class="card diamond-card">
                    @if (!string.IsNullOrWhiteSpace(pack.BadgeText))
                    {
                        <div class="card-badge @(pack.BadgeKind == "gold" ? "badge-gold" : "badge-purple")">@pack.BadgeText</div>
                    }

                    <div class="img-square">image</div>
                    <div class="diamond-amount">@pack.Amount</div>
                    <div class="diamond-price">@pack.PriceLabel</div>

                    <button class="btn btn-primary btn-full" type="button" @onclick="() => AddToCart(pack)">
                        @Lang.T("В корзину", "Add to cart", "In den Warenkorb", "Ajouter au panier", "Añadir al carrito")
                    </button>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private IReadOnlyList<DiamondPack> Packs =>
        Lang.Current switch
        {
            LanguageState.Language.Ru => RuPacks,
            LanguageState.Language.En => EnPacks,
            LanguageState.Language.De => DePacks,
            LanguageState.Language.Fr => FrPacks,
            LanguageState.Language.Es => EsPacks,
            _ => EnPacks
        };

    private static readonly IReadOnlyList<DiamondPack> RuPacks =
    [
        new("60 алмазов", 0.99m, "€0.99", null, null),
        new("120 алмазов", 1.99m, "€1.99", null, null),
        new("350 алмазов", 4.99m, "€4.99", "Best value", "purple"),
        new("800 алмазов", 9.99m, "€9.99", null, null),
