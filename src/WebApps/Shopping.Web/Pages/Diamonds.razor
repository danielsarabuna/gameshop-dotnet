@page "/diamonds"
@inject CartState Cart
@inject LanguageState Lang
@inject HttpClient Http
@inject IConfiguration Config

<PageTitle>GameShop — @Lang.T("Алмазы", "Diamonds", "Diamanten", "Diamants", "Diamantes")</PageTitle>

<div class="page-container">
    <div class="page-header seq-item seq-delay-1">
        <h1 class="page-title">
            <span class="gradient-text">💎 @Lang.T("Алмазы", "Diamonds", "Diamanten", "Diamants", "Diamantes")</span>
        </h1>
        <p class="page-subtitle">
            @Lang.T(
                "Выберите пакет алмазов для мгновенного зачисления на игровой аккаунт. Начисление занимает 1–3 минуты.",
                "Choose a diamond pack for instant delivery to your game account. Instant delivery in 1-3 minutes.",
                "Wähle ein Diamanten‑Paket für sofortige Lieferung auf dein Spielkonto. Die Lieferung dauert 1-3 Minuten.",
                "Choisissez un pack de diamants pour une livraison instantanée sur votre compte de jeu en 1 à 3 minutes.",
                "Elige un paquete de diamantes para su entrega instantánea en tu cuenta en 1-3 minutos."
            )
        </p>
    </div>

    @if (Packs.Count == 0)
    {
        <div class="seq-item seq-delay-2" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px;">
            @for (int i = 1; i <= 4; i++)
            {
                int diamonds = i * 150;
                decimal price = i * 4.99m;
                <div class="glass-card" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; position: relative;">
                    @if (i == 2)
                    {
                        <span class="badge-tag badge-pink" style="position: absolute; top: 16px; right: 16px;">
                            @Lang.T("ХИТ", "HOT", "HOT", "HOT", "POPULAR")
                        </span>
                    }
                    else if (i == 4)
                    {
                        <span class="badge-tag badge-gold" style="position: absolute; top: 16px; right: 16px;">
                            @Lang.T("ВЫГОДНО", "BEST VALUE", "BESTES ANGEBOT", "MEILLEURE OFFRE", "MEJOR OFERTA")
                        </span>
                    }

                    <div style="font-size: 3rem; margin-top: 10px;">💎</div>
                    <div style="font-size: 1.3rem; font-weight: 800; color: #ffffff;">@FormatDiamondAmount(diamonds)</div>
                    <div style="font-size: 1.5rem; font-weight: 900; color: var(--accent-pink);">€@price.ToString("0.00")</div>
                    
                    <button class="btn btn-primary" style="width: 100%; margin-top: 10px;" type="button" @onclick="() => AddDemoPackToCart(diamonds, price)">
                        @Lang.T("В корзину", "Add to cart", "In den Warenkorb", "Ajouter au panier", "Añadir al carrito")
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="seq-item seq-delay-2" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px;">
            @foreach (var pack in Packs)
            {
                <div class="glass-card" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; position: relative;">
                    @if (!string.IsNullOrWhiteSpace(GetBadgeText(pack.BadgeKey)))
                    {
                        <div style="position: absolute; top: 16px; right: 16px;">
                            <span class="badge-tag @(pack.BadgeKind == "gold" ? "badge-gold" : "badge-pink")">
                                @GetBadgeText(pack.BadgeKey)
                            </span>
                        </div>
                    }

                    <div style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; font-size: 3rem; margin-top: 10px;">
                        @if (!string.IsNullOrWhiteSpace(pack.ImageUrl))
                        {
                            <img src="@pack.ImageUrl" alt="@pack.Diamonds diamonds" style="width: 100%; height: 100%; object-fit: contain;" />
                        }
                        else
                        {
                            <span>💎</span>
                        }
                    </div>

                    <div style="font-size: 1.3rem; font-weight: 800; color: #ffffff;">@FormatDiamondAmount(pack.Diamonds)</div>
                    <div style="font-size: 1.5rem; font-weight: 900; color: var(--accent-pink);">@pack.PriceLabel</div>

                    <button class="btn btn-primary" style="width: 100%; margin-top: 10px;" type="button" @onclick="() => AddToCart(pack)">
                        @Lang.T("В корзину", "Add to cart", "In den Warenkorb", "Ajouter au panier", "Añadir al carrito")
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<DiamondPack> Packs => _packs;
    private IReadOnlyList<DiamondPack> _packs = [];

    protected override async Task OnInitializedAsync()
    {
        _packs = await LoadPacksAsync();
    }

    private void AddToCart(DiamondPack pack)
    {
        var amountLabel = FormatDiamondAmount(pack.Diamonds);
        Cart.AddItem($"diamonds:{pack.Id:D}", amountLabel, pack.PriceValue, 1);
    }

    private void AddDemoPackToCart(int diamonds, decimal price)
    {
        var label = FormatDiamondAmount(diamonds);
        Cart.AddItem($"diamonds:demo-{diamonds}", label, price, 1);
    }

    private async Task<IReadOnlyList<DiamondPack>> LoadPacksAsync()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<IReadOnlyList<CatalogItemDto>>(CatalogItemsUrl);
            if (items is null) return [];

            return items
                .Where(item => string.Equals(item.Type, "Currency", StringComparison.OrdinalIgnoreCase) && item.IsActive)
                .Select(MapFromCatalog)
                .Where(pack => pack is not null)
                .Select(pack => pack!)
                .OrderBy(pack => pack.Diamonds)
                .ToList();
        }
        catch
        {
            return [];
        }
    }

    private string CatalogItemsUrl
    {
        get
        {
            var baseUrl = Config["ApiBaseUrl"]?.Trim();
            return string.IsNullOrWhiteSpace(baseUrl)
                ? "/api/v1/catalog/items"
                : $"{baseUrl.TrimEnd('/')}/api/v1/catalog/items";
        }
    }

    private static DiamondPack? MapFromCatalog(CatalogItemDto item)
    {
        if (!item.Metadata.TryGetValue("diamonds", out var diamondsText) ||
            !int.TryParse(diamondsText, out var diamonds))
        {
            return null;
        }

        return new DiamondPack(
            item.Id,
            diamonds,
            item.Price,
            $"€{item.Price:0.00}",
            GetMetadataValue(item.Metadata, "badgeKey"),
            GetBadgeKindFromMetadata(item.Metadata),
            item.ImageUrl);
    }

    private string FormatDiamondAmount(int diamonds) =>
        string.Format(
            Lang.T("{0} алмазов", "{0} diamonds", "{0} Diamanten", "{0} diamants", "{0} diamantes"),
            diamonds);

    private string? GetBadgeText(string? badgeKey) => badgeKey switch
    {
        "best" => Lang.T("Выгодно", "Best value", "Bestes Angebot", "Meilleure offre", "Mejor oferta"),
        "top" => Lang.T("Топ", "Top", "Top", "Top", "Top"),
        "hot" => Lang.T("Хит", "Hot", "Hot", "Hot", "Hot"),
        "mega" => Lang.T("Мега", "Mega", "Mega", "Mega", "Mega"),
        _ => null
    };

    private static string? GetBadgeKindFromMetadata(IReadOnlyDictionary<string, string> metadata)
    {
        var value = GetMetadataValue(metadata, "badgeKind")?.ToLowerInvariant();
        return value is "gold" or "purple" ? value : null;
    }

    private static string? GetMetadataValue(IReadOnlyDictionary<string, string> metadata, string key) =>
        metadata.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value)
            ? value
            : null;

    private sealed record DiamondPack(Guid Id, int Diamonds, decimal PriceValue, string PriceLabel, string? BadgeKey, string? BadgeKind, string? ImageUrl);

    private sealed record CatalogItemDto(
        Guid Id,
        string Title,
        string Description,
        string Type,
        decimal Price,
        string Currency,
        bool IsActive,
        Dictionary<string, string> Metadata,
        string? ImageUrl);
}
