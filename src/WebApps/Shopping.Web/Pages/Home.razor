@page "/"
@inject LanguageState Lang

<PageTitle>GameShop — @Lang.T("Студия мобильных интерактивных историй", "Mobile Interactive Stories Studio", "Studio für interaktive Geschichten", "Studio d'histoires interactives", "Estudio de historias interactivas")</PageTitle>

<div class="page-container" style="padding-top: 140px; padding-bottom: 60px;">
    <!-- HERO SECTION -->
    <div style="display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 60px;">
        <div class="seq-item seq-delay-1" style="margin-bottom: 16px;">
            <span class="badge-tag badge-pink">
                @Lang.T("НОВОЕ ОБНОВЛЕНИЕ • СЕЗОН 3", "NEW UPDATE • SEASON 3 RELEASED", "NEUES UPDATE • STAFFEL 3", "NOUVELLE MISE À JOUR • SAISON 3", "NUEVA ACTUALIZACIÓN • TEMPORADA 3")
            </span>
        </div>

        <h1 class="seq-item seq-delay-2 page-title" style="max-width: 820px; margin-bottom: 20px;">
            @Lang.T("Погрузитесь в мир", "Immerse yourself in a world of", "Tauche ein in die Welt der", "Plongez dans un monde d'", "Sumérgete en un mundo de")
            <span class="gradient-text"> @Lang.T("интерактивных новелл", "interactive novels", "interaktiven Geschichten", "romans interactifs", "novelas interactivas")</span>
            @Lang.T(" и романтики", " and romance", " und Romantik", " et de romance", " y romance")
        </h1>

        <p class="seq-item seq-delay-3 page-subtitle" style="max-width: 680px; margin-bottom: 32px;">
            @Lang.T(
                "Покупайте алмазы и Premium, чтобы ускорить прогресс, разблокировать секретные сюжетные линии и выбирать уникальные решения в вашей любимой игре.",
                "Buy diamonds and Premium to speed up progress, unlock secret storylines, and make unique choices in your favorite interactive game.",
                "Kaufe Diamanten und Premium, um schneller voranzukommen und exklusive Inhalte in deiner Dating-Simulation freizuschalten.",
                "Achetez des diamants et Premium pour accélérer la progression et débloquer du contenu exclusif dans votre jeu.",
                "Compra diamantes y Premium para avanzar más rápido y desbloquear contenido exclusivo en tu juego."
            )
        </p>

        <div class="seq-item seq-delay-4" style="display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap;">
            <a class="btn btn-primary" href="/diamonds">
                <span>💎 @Lang.BuyDiamonds</span>
            </a>
            <a class="btn btn-outline" href="/subscription">
                <span>✨ @Lang.Premium</span>
            </a>
        </div>
    </div>

    <!-- SHOWCASE MEDIA & CARDS GRID -->
    <div class="cards-grid seq-item seq-delay-5" style="margin-bottom: 60px;">
        <div class="glass-card" style="display: flex; flex-direction: column; gap: 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                <span class="badge-tag badge-cyan">
                    @Lang.T("ЗАПИСЬ • ПРЕВЬЮ ГЕЙМПЛЕЯ", "REC • GAMEPLAY PREVIEW", "VORSCHAU • GAMEPLAY", "REC • APERÇU DU JEU", "REC • VISTA PREVIA")
                </span>
                <span style="font-size: 0.8rem; color: var(--text-dim);">Story Realms Interactive</span>
            </div>
            
            <div style="border-radius: 16px; overflow: hidden; background: rgba(0,0,0,0.5); min-height: 220px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-color);">
                <object class="gif-media" data="gifs/gameplay.gif" type="image/gif" style="width: 100%; height: auto; max-height: 320px; object-fit: cover;">
                    <div style="padding: 40px; text-align: center; color: var(--text-muted);">🎮 Gameplay Preview</div>
                </object>
            </div>

            <div>
                <h3 style="margin-bottom: 8px;">
                    @Lang.T("Выбирай свой путь", "Choose your path", "Wähle deinen Weg", "Choisissez votre voie", "Elige tu camino")
                </h3>
                <p style="font-size: 0.92rem; line-height: 1.55;">
                    @Lang.T(
                        "Каждое ваше решение меняет отношения с персонажами и открывает уникальные концовки историй.",
                        "Every choice shapes relationships with characters and unlocks unique story endings.",
                        "Jede Entscheidung beeinflusst Beziehungen zu Charakteren und schaltet einzigartige Enden frei.",
                        "Chaque choix façonne les relations avec les personnages et débloque des fins uniques.",
                        "Cada decisión moldea las relaciones con los personajes y desbloquea finales únicos."
                    )
                </p>
            </div>
        </div>

        <div class="glass-card" style="display: flex; flex-direction: column; gap: 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                <span class="badge-tag badge-pink">
                    @Lang.T("ПЕРСОНАЖИ", "CHARACTERS", "CHARAKTERE", "PERSONNAGES", "PERSONAJES")
                </span>
                <span style="font-size: 0.8rem; color: var(--text-dim);">Lucian & Elena</span>
            </div>

            <div style="border-radius: 16px; overflow: hidden; background: rgba(0,0,0,0.5); min-height: 220px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-color);">
                <object class="gif-media" data="gifs/characters.gif" type="image/gif" style="width: 100%; height: auto; max-height: 320px; object-fit: cover;">
                    <div style="padding: 40px; text-align: center; color: var(--text-muted);">✨ Characters Roster</div>
                </object>
            </div>

            <div>
                <h3 style="margin-bottom: 8px;">
                    @Lang.T("Живые персонажи", "Vibrant characters", "Lebendige Charaktere", "Personnages vivants", "Personajes vivos")
                </h3>
                <p style="font-size: 0.92rem; line-height: 1.55;">
                    @Lang.T(
                        "Познакомьтесь с десятками харизматичных героев с уникальной озвучкой и характерами.",
                        "Meet dozens of charismatic heroes with unique voice acting and distinct personalities.",
                        "Lerne Dutzende charismatischer Helden mit einzigartiger Sprachausgabe kennen.",
                        "Rencontrez des dizaines de héros charismatiques avec un doublage unique.",
                        "Conoce a docenas de héroes carismáticos con doblaje único y distintas personalidades."
                    )
                </p>
            </div>
        </div>
    </div>

    <!-- FEATURES LIST -->
    <div class="cards-grid-3">
        <div class="glass-card">
            <div style="font-size: 2rem; margin-bottom: 12px;">⚡</div>
            <h3 style="margin-bottom: 8px;">
                @Lang.T("Мгновенное зачисление", "Instant delivery", "Sofortige Lieferung", "Livraison instantanée", "Entrega instantánea")
            </h3>
            <p style="font-size: 0.88rem; line-height: 1.55;">
                @Lang.T(
                    "Алмазы и подписки поступают на ваш игровой аккаунт сразу после подтверждения оплаты.",
                    "Diamonds and subscriptions arrive at your game account right after payment confirmation.",
                    "Diamanten und Abos gelangen direkt nach Zahlungsbestätigung auf dein Spielkonto.",
                    "Les diamants et abonnements arrivent sur votre compte immédiatement après confirmation du paiement.",
                    "Los diamantes y suscripciones llegan a tu cuenta inmediatamente tras confirmar el pago."
                )
            </p>
        </div>

        <div class="glass-card">
            <div style="font-size: 2rem; margin-bottom: 12px;">🔒</div>
            <h3 style="margin-bottom: 8px;">
                @Lang.T("Безопасные платежи", "Secure payments", "Sichere Zahlungen", "Paiements sécurisés", "Pagos seguros")
            </h3>
            <p style="font-size: 0.88rem; line-height: 1.55;">
                @Lang.T(
                    "Поддержка банковских карт, СБП, Stripe, PayPal и безопасных локальных шлюзов.",
                    "Full support for bank cards, SBP, Stripe, PayPal, and encrypted payment gateways.",
                    "Unterstützung für Kreditkarten, Stripe, PayPal und sichere lokale Zahlungsgateways.",
                    "Prise en charge des cartes bancaires, Stripe, PayPal et passerelles sécurisées.",
                    "Soporte para tarjetas bancarias, Stripe, PayPal y pasarelas de pago seguras."
                )
            </p>
        </div>

        <div class="glass-card">
            <div style="font-size: 2rem; margin-bottom: 12px;">💬</div>
            <h3 style="margin-bottom: 8px;">
                @Lang.T("Поддержка 24/7", "24/7 Support", "24/7 Support", "Support 24/7", "Soporte 24/7")
            </h3>
            <p style="font-size: 0.88rem; line-height: 1.55;">
                @Lang.T(
                    "Наша команда поддержки всегда на связи и готова помочь вам в любое время суток.",
                    "Our dedicated support team is online and ready to assist you around the clock.",
                    "Unser Support-Team ist rund um die Uhr erreichbar und hilft dir jederzeit gerne weiter.",
                    "Notre équipe de support est en ligne 24/7 et prête à vous aider à tout moment.",
                    "Nuestro equipo de soporte está disponible 24/7 para ayudarte en cualquier momento."
                )
            </p>
        </div>
    </div>
</div>
