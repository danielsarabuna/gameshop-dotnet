                new("sub-3", "Bonus inactifs après paiement ?", "Redémarrez le jeu et actualisez. Sinon, contactez le support avec le reçu.")
            ]
        ),
        new(
            "Compte",
            [
                new("acc-1", "Où trouver mon ID dans le jeu ?", "Souvent dans Profil/Paramètres. Cherchez Player ID ou UID."),
                new("acc-2", "Comment lier mon compte ?", "Dans les paramètres, choisissez une méthode (email/réseaux) puis confirmez.")
            ]
        ),
        new(
            "Divers",
            [
                new("misc-1", "Comment contacter le support ?", "Via le formulaire du site ou l’email de support (voir Contacts)."),
                new("misc-2", "Y a‑t‑il des remboursements ?", "Possible dans certains cas. Contactez le support pour examen.")
            ]
        )
    ];

    private static readonly IReadOnlyList<FaqGroup> EsGroups =
    [
        new(
            "Diamantes & Pago",
            [
                new("pay-1", "¿Cómo compro diamantes?", "Abre Diamantes, elige un paquete y pulsa Añadir al carrito. Luego sigue los pasos de pago."),
                new("pay-2", "¿Qué métodos de pago hay?", "Depende de tu región. En el checkout mostraremos las opciones disponibles."),
                new("pay-3", "No llegaron los diamantes — ¿qué hago?", "Verifica tu ID. Si pasan más de 15 minutos, contacta soporte con el recibo.")
            ]
        ),
        new(
            "Suscripción",
            [
                new("sub-1", "¿Qué incluye Premium?", "Bonos diarios, escenas exclusivas, progreso más rápido y recompensas únicas."),
                new("sub-2", "¿Cómo cancelo la suscripción?", "Depende del método de pago. En tu cuenta (o proveedor) elige Cancelar."),
                new("sub-3", "¿Bonos no activos tras pagar?", "Reinicia el juego y actualiza. Si sigue igual, contacta soporte con el recibo.")
            ]
        ),
        new(
            "Cuenta",
            [
                new("acc-1", "¿Dónde encuentro mi ID en el juego?", "Normalmente en Perfil/Ajustes. Busca Player ID o UID."),
                new("acc-2", "¿Cómo vinculo mi cuenta?", "En ajustes, elige un método (correo/redes) y confirma.")
            ]
        ),
        new(
            "Otros",
            [
                new("misc-1", "¿Cómo contacto con soporte?", "Usa el formulario del sitio o el email de soporte (ver Contactos)."),
