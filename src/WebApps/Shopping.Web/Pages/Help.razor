@page "/help"
@inject LanguageState Lang

<PageTitle>GameShop — @Lang.T("Помощь", "Help", "Hilfe", "Aide", "Ayuda")</PageTitle>

<section class="page-pad">
    <div class="container">
        <div class="narrow" style="max-width: 720px;">
            
            <div class="help-header">
                <h1>@Lang.T("Чем мы можем помочь?", "How can we help?", "Wie können wir helfen?", "Comment pouvons-nous aider?", "¿Cómo podemos ayudar?")</h1>
                <p class="muted">
                    @Lang.T(
                        "Найдите ответы на частые вопросы или свяжитесь с нами напрямую.",
                        "Find answers to common questions or contact us directly.",
                        "Finde Antworten auf häufige Fragen oder kontaktiere uns direkt.",
                        "Trouvez des réponses aux questions fréquentes ou contactez-nous directement.",
                        "Encuentra respuestas a preguntas frecuentes o contáctanos directamente."
                    )
                </p>
            </div>

            <div class="faq">
                @foreach (var group in CurrentGroups)
                {
                    <div>
                        <div class="faq-group-label">@group.Label</div>
                        @foreach (var item in group.Items)
                        {
                            var open = OpenIds.Contains(item.Id);
                            <div class="accordion-item">
                                <button class="accordion-q" type="button" @onclick="() => Toggle(item.Id)">
                                    <span>@item.Question</span>
                                    <span class="icon chev @(open ? "open" : "")" aria-hidden="true">@((MarkupString)Icons.Chevron)</span>
                                </button>
                                <div class="accordion-a @(open ? "open" : "")">
                                    <div class="accordion-a-inner">
                                        @item.Answer
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="help-form" id="contact-form" style="margin-top: 48px;">
                <h2>@Lang.T("Свяжитесь с нами", "Contact us", "Kontaktiere uns", "Contactez-nous", "Contáctanos")</h2>
                <input placeholder="@Lang.T("Имя", "Name", "Name", "Nom", "Nombre")" />
                <input placeholder="Email" type="email" />
                <textarea placeholder="@Lang.T("Сообщение", "Message", "Nachricht", "Message", "Mensaje")" rows="4"></textarea>
                <button class="btn btn-primary" style="width: 100%;">@Lang.T("Отправить", "Send", "Senden", "Envoyer", "Enviar")</button>
            </div>

            <div class="help-contacts">
                <div class="contact-item">
                    <span class="contact-icon">✉️</span>
                    <span>support@GameShop.com</span>
                </div>
                <div class="contact-item">
                    <span class="contact-icon">💬</span>
                    <span>@Lang.T("Онлайн-чат", "Online chat", "Online-Chat", "Chat en ligne", "Chat en línea")</span>
                </div>
                <div class="contact-item">
                    <span class="contact-icon">📞</span>
                    <span>+7 (999) 123-45-67</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly HashSet<string> OpenIds = new(StringComparer.Ordinal);

    private void Toggle(string id)
    {
        if (!OpenIds.Add(id))
        {
            OpenIds.Remove(id);
        }
    }

    private IReadOnlyList<FaqGroup> CurrentGroups =>
        Lang.Current switch
        {
            LanguageState.Language.Ru => RuGroups,
            LanguageState.Language.En => EnGroups,
            LanguageState.Language.De => DeGroups,
            LanguageState.Language.Fr => FrGroups,
            LanguageState.Language.Es => EsGroups,
            _ => EnGroups
        };

    private static readonly IReadOnlyList<FaqGroup> RuGroups =
    [
        new(
            "Алмазы & Оплата",
            [
                new("pay-1", "Как купить алмазы?", "Откройте «Алмазы», выберите пакет и нажмите «В корзину». Далее следуйте шагам оплаты."),
                new("pay-2", "Какие способы оплаты доступны?", "Доступные способы зависят от региона. При оформлении мы покажем актуальные варианты."),
                new("pay-3", "Алмазы не начислились — что делать?", "Проверьте, что указан правильный ID. Если прошло более 15 минут — напишите в поддержку с чеком.")
            ]
        ),
        new(
            "Подписка",
            [
                new("sub-1", "Что входит в Premium?", "Ежедневные бонусы, эксклюзивные сцены, ускорение прогресса и уникальные награды."),
                new("sub-2", "Как отменить подписку?", "Отмена зависит от способа оплаты. В личном кабинете (или у провайдера платежа) выберите «Отменить»."),
                new("sub-3", "Бонусы не активны после оплаты?", "Обновите игру и перезапустите. Если не помогло — обратитесь в поддержку, приложив квитанцию.")
            ]
        ),
        new(
            "Аккаунт",
            [
                new("acc-1", "Где найти мой ID в игре?", "Обычно ID находится в профиле/настройках аккаунта. Ищите строку «Player ID» или «UID»."),
                new("acc-2", "Как привязать аккаунт?", "В настройках игры включите привязку через доступные способы (почта/соцсети) и подтвердите действие.")
            ]
        ),
        new(
            "Прочее",
            [
                new("misc-1", "Как связаться с поддержкой?", "Напишите нам через форму на сайте или на email поддержки (укажем в разделе контактов)."),
                new("misc-2", "Есть ли возврат средств?", "Возврат возможен в отдельных случаях. Обратитесь в поддержку — рассмотрим заявку.")
            ]
        )
    ];

    private static readonly IReadOnlyList<FaqGroup> EnGroups =
    [
        new(
            "Diamonds & Payment",
            [
                new("pay-1", "How do I buy diamonds?", "Open Diamonds, pick a pack, and click Add to cart. Then follow the payment steps."),
                new("pay-2", "Which payment methods are available?", "Available methods depend on your region. We’ll show the current options at checkout."),
                new("pay-3", "Diamonds didn’t arrive—what should I do?", "Double-check your ID. If it’s been over 15 minutes, contact support with your receipt.")
            ]
        ),
        new(
            "Subscription",
            [
                new("sub-1", "What’s included in Premium?", "Daily bonuses, exclusive scenes, faster progression, and unique rewards."),
                new("sub-2", "How do I cancel my subscription?", "Cancellation depends on your payment method. In your account (or payment provider), choose Cancel."),
                new("sub-3", "Bonuses aren’t active after payment?", "Restart the game and refresh. If it still doesn’t work, contact support with your receipt.")
            ]
        ),
        new(
            "Account",
            [
                new("acc-1", "Where can I find my in-game ID?", "Usually in Profile/Settings. Look for Player ID or UID."),
                new("acc-2", "How do I link my account?", "Open game settings, choose an available method (email/social), and confirm.")
            ]
        ),
        new(
            "Other",
            [
                new("misc-1", "How can I contact support?", "Reach us via the website form or support email (see Contacts)."),
                new("misc-2", "Do you offer refunds?", "Refunds may be available in certain cases. Contact support and we’ll review your request.")
            ]
        )
    ];

    private static readonly IReadOnlyList<FaqGroup> DeGroups =
    [
        new(
            "Diamanten & Zahlung",
            [
                new("pay-1", "Wie kaufe ich Diamanten?", "Öffne Diamanten, wähle ein Paket und klicke In den Warenkorb. Dann den Zahlungsschritten folgen."),
                new("pay-2", "Welche Zahlungsmethoden gibt es?", "Das hängt von deiner Region ab. Beim Checkout zeigen wir die verfügbaren Optionen."),
                new("pay-3", "Diamanten sind nicht angekommen – was tun?", "Prüfe die ID. Wenn es länger als 15 Minuten dauert, kontaktiere den Support mit Beleg.")
            ]
        ),
        new(
            "Abo",
            [
                new("sub-1", "Was ist in Premium enthalten?", "Tägliche Boni, exklusive Szenen, schnellerer Fortschritt und einzigartige Belohnungen."),
                new("sub-2", "Wie kündige ich?", "Die Kündigung hängt von der Zahlungsart ab. In deinem Konto (oder beim Zahlungsanbieter) Abbrechen wählen."),
                new("sub-3", "Boni nach Zahlung nicht aktiv?", "Spiel neu starten und aktualisieren. Falls es bleibt, Support mit Beleg kontaktieren.")
            ]
        ),
        new(
            "Konto",
            [
                new("acc-1", "Wo finde ich meine In‑Game‑ID?", "Meist in Profil/Einstellungen. Suche nach Player ID oder UID."),
                new("acc-2", "Wie verknüpfe ich mein Konto?", "In den Einstellungen eine Methode (E‑Mail/Sozial) wählen und bestätigen.")
            ]
        ),
        new(
            "Sonstiges",
            [
                new("misc-1", "Wie erreiche ich den Support?", "Über das Formular auf der Website oder per Support‑E‑Mail (siehe Kontakte)."),
                new("misc-2", "Gibt es Rückerstattungen?", "In bestimmten Fällen möglich. Kontaktiere den Support, wir prüfen die Anfrage.")
            ]
        )
    ];

    private static readonly IReadOnlyList<FaqGroup> FrGroups =
    [
        new(
            "Diamants & Paiement",
            [
                new("pay-1", "Comment acheter des diamants ?", "Ouvrez Diamants, choisissez un pack puis cliquez Ajouter au panier. Suivez ensuite le paiement."),
                new("pay-2", "Quels moyens de paiement sont disponibles ?", "Cela dépend de votre région. Nous afficherons les options au paiement."),
                new("pay-3", "Les diamants ne sont pas arrivés — que faire ?", "Vérifiez votre ID. Après 15 minutes, contactez le support avec le reçu.")
