    private sealed record FaqItem(string Id, string Question, string Answer);

    private sealed record FaqGroup(string Label, IReadOnlyList<FaqItem> Items);
}

@code {
    private static class Icons
    {
        public const string Chevron =
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M6 9l6 6 6-6' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>";
    }
}
