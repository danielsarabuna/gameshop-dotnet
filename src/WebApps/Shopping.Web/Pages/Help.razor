@page "/help"
@inject LanguageState Lang

<PageTitle>GameShop — @Lang.T("Помощь и FAQ", "Help & FAQ", "Hilfe & FAQ", "Aide & FAQ", "Ayuda y FAQ")</PageTitle>

<div class="page-container" style="max-width: 900px;">
    <!-- HEADER -->
    <div class="page-header seq-item seq-delay-1">
        <h1 class="page-title">
            <span class="gradient-text">💬 @Lang.T("Чем мы можем помочь?", "How can we help?", "Wie können wir helfen?", "Comment pouvons-nous aider?", "¿Cómo podemos ayudar?")</span>
        </h1>
        <p class="page-subtitle">
            @Lang.T(
                "Найдите ответы на частые вопросы по покупкам, подпискам и аккаунту или отправьте нам сообщение.",
                "Find answers to common questions about purchases, subscriptions, and accounts or send us a message.",
                "Finde Antworten auf häufige Fragen zu Käufen und Abos oder sende uns eine Nachricht.",
                "Trouvez des réponses aux questions fréquentes sur les achats et abonnements.",
                "Encuentra respuestas a preguntas frecuentes sobre compras y suscripciones."
            )
        </p>
    </div>

    <!-- FAQ ACCORDION -->
    <div class="seq-item seq-delay-2" style="display: flex; flex-direction: column; gap: 24px; margin-bottom: 50px;">
        @foreach (var group in CurrentGroups)
        {
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="font-size: 1.05rem; font-weight: 800; color: var(--accent-cyan); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px;">
                    @group.Label
                </div>
                
                @foreach (var item in group.Items)
                {
                    var open = OpenIds.Contains(item.Id);
                    <div class="glass-card" style="padding: 20px; cursor: pointer;" @onclick="() => Toggle(item.Id)">
                        <div style="display: flex; align-items: center; justify-content: space-between; font-weight: 700; font-size: 1.05rem; color: #ffffff;">
                            <span>@item.Question</span>
                            <span style="font-size: 1.2rem; transition: transform 0.3s ease; transform: rotate(@(open ? "180deg" : "0deg")); color: var(--accent-pink);">
                                ▼
                            </span>
                        </div>

                        @if (open)
                        {
                            <div style="margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border-color); font-size: 0.95rem; line-height: 1.6; color: var(--text-muted); animation: fadeIn 0.2s ease-out;">
                                @item.Answer
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- CONTACT FORM & SUPPORT -->
    <div class="glass-card seq-item seq-delay-3" style="padding: 36px;">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 20px; text-align: center; color: #ffffff;">
            ✉️ @Lang.T("Служба поддержки", "Support Service", "Kundenservice", "Service Support", "Servicio de Soporte")
        </h2>

        <div style="display: flex; flex-direction: column; gap: 16px; margin-bottom: 24px;">
            <input class="cart-input" placeholder="@Lang.T("Ваше имя", "Your Name", "Dein Name", "Votre nom", "Tu nombre")" />
            <input class="cart-input" type="email" placeholder="@Lang.T("Ваш Email", "Your Email", "Deine E-Mail", "Votre email", "Tu email")" />
            <textarea class="cart-input" style="min-height: 110px; resize: vertical;" placeholder="@Lang.T("Опишите ваш вопрос...", "Describe your question...", "Beschreibe deine Frage...", "Décrivez votre question...", "Describe tu pregunta...")"></textarea>
            
            <button class="btn btn-primary" style="width: 100%;" type="button" @onclick="SubmitForm">
                @Lang.T("Отправить обращение", "Submit Ticket", "Nachricht senden", "Envoyer", "Enviar ticket")
            </button>

            @if (Submitted)
            {
                <div style="color: var(--accent-cyan); text-align: center; font-weight: 600; margin-top: 8px;">
                    ✓ @Lang.T("Ваше сообщение отправлено! Мы ответим вам в течение 15 минут.", "Your message has been sent! We will reply within 15 minutes.", "Deine Nachricht wurde gesendet! Wir antworten innerhalb von 15 Minuten.", "Votre message a été envoyé ! Nous vous répondrons dans les 15 minutes.", "¡Tu mensaje ha sido enviado! Responderemos en 15 minutos.")
                </div>
            }
        </div>

        <div style="display: flex; align-items: center; justify-content: center; gap: 24px; flex-wrap: wrap; padding-top: 16px; border-top: 1px solid var(--border-color); font-size: 0.9rem; color: var(--text-muted);">
            <div>✉️ support@GameShop.com</div>
            <div>💬 @Lang.T("Онлайн-чат 24/7", "24/7 Live Chat", "24/7 Live-Chat", "Chat en direct 24/7", "Chat en vivo 24/7")</div>
        </div>
    </div>
</div>

@code {
    private readonly HashSet<string> OpenIds = new(StringComparer.Ordinal) { "pay-1" };
    private bool Submitted;

    private void Toggle(string id)
    {
        if (!OpenIds.Add(id))
        {
            OpenIds.Remove(id);
        }
    }

    private void SubmitForm()
    {
        Submitted = true;
    }

    private IReadOnlyList<FaqGroup> CurrentGroups =>
        Lang.Current switch
        {
            LanguageState.Language.Ru => RuGroups,
            LanguageState.Language.En => EnGroups,
            LanguageState.Language.De => DeGroups,
            LanguageState.Language.Fr => FrGroups,
            LanguageState.Language.Es => EsGroups,
            _ => EnGroups
        };

    private static readonly IReadOnlyList<FaqGroup> RuGroups =
    [
        new(
            "Алмазы & Оплата",
            [
                new("pay-1", "Как быстро зачисляются алмазы?", "Алмазы поступают на игровой аккаунт мгновенно сразу после подтверждения оплаты (обычно от 30 секунд до 3 минут)."),
                new("pay-2", "Какие способы оплаты поддерживаются?", "Мы принимаем банковские карты Visa/Mastercard/MIR, СБП, ЮMoney, PayPal, Stripe и CorvusPay.")
            ]
        ),
        new(
            "Подписка Premium",
            [
                new("sub-1", "Как отменить или продлить подписку?", "Подписка действует оплаченный период (1, 3 или 12 месяцев). По истечении срока вы можете продлить её в один клик."),
                new("sub-2", "Сохранятся ли бонусы после окончания подписки?", "Все предметы кастомизации и полученные сюжетные награды остаются на вашем аккаунте навсегда.")
            ]
        )
    ];

    private static readonly IReadOnlyList<FaqGroup> EnGroups =
    [
        new(
            "Diamonds & Payments",
            [
                new("pay-1", "How fast are diamonds delivered?", "Diamonds are delivered to your game account instantly after payment confirmation (usually 30s to 3 minutes)."),
                new("pay-2", "Which payment methods are accepted?", "We accept Visa, Mastercard, PayPal, Stripe, Apple Pay, Google Pay, and regional gateways.")
            ]
        ),
        new(
            "Premium Subscription",
            [
                new("sub-1", "How do I renew or cancel my subscription?", "Your subscription stays active for the selected term. You can easily renew or change plans anytime."),
                new("sub-2", "Do I keep unlocked rewards after Premium expires?", "Yes, all customization items and storyline unlocks remain permanently linked to your account.")
            ]
        )
    ];

    private static readonly IReadOnlyList<FaqGroup> DeGroups =
    [
        new(
            "Diamanten & Zahlungen",
            [
                new("pay-1", "Wie schnell werden Diamanten geliefert?", "Diamanten werden sofort nach Zahlungsbestätigung geliefert (in der Regel 30 Sek. bis 3 Min.)."),
                new("pay-2", "Welche Zahlungsmethoden werden unterstützt?", "Wir akzeptieren Visa, Mastercard, PayPal, Stripe und regionale Zahlungsmethoden.")
            ]
        ),
        new(
            "Premium-Abo",
            [
                new("sub-1", "Wie kann ich mein Abo verlängern?", "Dein Abo bleibt für den gewählten Zeitraum aktiv. Du kannst es jederzeit mit einem Klick verlängern."),
                new("sub-2", "Bleiben Belohnungen nach Ablauf erhalten?", "Ja, alle freigeschalteten Objekte bleiben dauerhaft auf deinem Konto.")
            ]
        )
    ];

    private static readonly IReadOnlyList<FaqGroup> FrGroups =
    [
        new(
            "Diamants & Paiements",
            [
                new("pay-1", "À quelle vitesse les diamants sont-ils livrés ?", "Les diamants sont livrés instantanément sur votre compte après confirmation du paiement (30s à 3 min)."),
                new("pay-2", "Quels moyens de paiement sont acceptés ?", "Nous acceptons Visa, Mastercard, PayPal, Stripe et d'autres moyens sécurisés.")
            ]
        ),
        new(
            "Abonnement Premium",
            [
                new("sub-1", "Comment renouveler mon abonnement ?", "Votre abonnement reste actif pour la période choisie et peut être renouvelé en un clic."),
                new("sub-2", "Est-ce que je garde mes récompenses ?", "Oui, tous les objets débloqués restent associés définitivement à votre compte.")
            ]
        )
    ];

    private static readonly IReadOnlyList<FaqGroup> EsGroups =
    [
        new(
            "Diamantes y Pagos",
            [
                new("pay-1", "¿Qué tan rápido se entregan los diamantes?", "Los diamantes se entregan al instante en tu cuenta tras la confirmación del pago (30s a 3 min)."),
                new("pay-2", "¿Qué métodos de pago se aceptan?", "Aceptamos Visa, Mastercard, PayPal, Stripe y pasarelas de pago seguras.")
            ]
        ),
        new(
            "Suscripción Premium",
            [
                new("sub-1", "¿Cómo renovar la suscripción?", "Tu suscripción permanece activa durante el período seleccionado y puedes renovarla fácilmente."),
                new("sub-2", "¿Conservo las recompensas desbloqueadas?", "Sí, todos los elementos desbloqueados permanecen vinculados a tu cuenta para siempre.")
            ]
        )
    ];

    private sealed record FaqGroup(string Label, IReadOnlyList<FaqItem> Items);
    private sealed record FaqItem(string Id, string Question, string Answer);
}
