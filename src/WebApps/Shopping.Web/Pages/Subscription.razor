@page "/subscription"
@inject CartState Cart
@inject LanguageState Lang
@inject HttpClient Http
@inject IConfiguration Config

<PageTitle>GameShop — @Lang.T("Подписка", "Subscription", "Abo", "Abonnement", "Suscripción")</PageTitle>

<div class="page-container">
    <div class="page-header seq-item seq-delay-1">
        <h1 class="page-title">
            <span class="gradient-text">✨ GameShop Premium</span>
        </h1>
        <p class="page-subtitle">
            @Lang.T(
                "Подписка Premium открывает эксклюзивный сюжетный контент, секретные ветки диалогов и дает ежедневный бонус алмазов.",
                "Premium subscription unlocks exclusive storyline content, secret dialogue branches, and grants daily bonus diamonds.",
                "Das Premium-Abo schaltet exklusive Story-Inhalte und tägliche Bonus-Diamanten frei.",
                "L'abonnement Premium débloque du contenu exclusif et des diamants bonus quotidiens.",
                "La suscripción Premium desbloquea contenido exclusivo y diamantes de bonificación diarios."
            )
        </p>
    </div>

    <!-- TWO COLUMNS: BENEFITS & MEDIA SLOT -->
    <div class="cards-grid seq-item seq-delay-2" style="margin-bottom: 50px;">
        <div class="glass-card" style="display: flex; flex-direction: column; justify-content: center; gap: 20px;">
            <h2 style="font-size: 1.4rem; font-weight: 800; color: #ffffff;">
                @Lang.T("Что входит в подписку:", "What is included in Premium:", "Was ist im Abo enthalten:", "Ce qui est inclus dans le Premium :", "Lo que incluye Premium:")
            </h2>
            <div style="display: flex; flex-direction: column; gap: 14px;">
                @foreach (var benefit in CurrentBenefits)
                {
                    <div style="display: flex; align-items: center; gap: 12px; font-size: 0.98rem; color: #ffffff;">
                        <div style="width: 24px; height: 24px; border-radius: 50%; background: linear-gradient(135deg, #ff3366, #9933ff); display: flex; align-items: center; justify-content: center; font-size: 0.8rem; flex-shrink: 0; box-shadow: 0 2px 10px rgba(255, 51, 102, 0.4);">
                            ✓
                        </div>
                        <span>@benefit</span>
                    </div>
                }
            </div>
        </div>

        <div class="glass-card" style="display: flex; align-items: center; justify-content: center; padding: 12px; min-height: 260px;">
            <object class="gif-media" data="gifs/premium-content.gif" type="image/gif" style="width: 100%; height: auto; max-height: 280px; object-fit: cover; border-radius: 12px;">
                <div style="padding: 40px; text-align: center; color: var(--text-muted);">✨ Premium Content Preview</div>
            </object>
        </div>
    </div>

    <!-- TARIFF PLANS GRID -->
    <div class="seq-item seq-delay-3">
        <h2 style="text-align: center; margin-bottom: 32px;">
            @Lang.T("Выберите подходящий тариф:", "Choose a plan that fits you:", "Wähle den passenden Tarif:", "Choisissez le forfait qui vous convient :", "Elige el plan adecuado para ti:")
        </h2>

        <div class="cards-grid-3">
            @if (Plans.Count == 0)
            {
                <!-- Fallback / Default Tariffs -->
                <div class="glass-card" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; position: relative;">
                    <div style="font-size: 1.2rem; font-weight: 800; color: var(--text-muted);">
                        @Lang.T("1 Месяц", "1 Month", "1 Monat", "1 Mois", "1 Mes")
                    </div>
                    <div style="font-size: 2.2rem; font-weight: 900; color: #ffffff;">€9.99</div>
                    <div style="font-size: 0.85rem; color: var(--text-dim);">
                        @Lang.T("Ежемесячно", "Monthly", "Monatlich", "Mensuel", "Mensual")
                    </div>
                    <button class="btn btn-outline" style="width: 100%; margin-top: 10px;" type="button" @onclick='() => BuyDemo("1-month", Lang.T("1 Месяц", "1 Month", "1 Monat", "1 Mois", "1 Mes"), 9.99m)'>
                        @Lang.T("Выбрать", "Select plan", "Wählen", "Choisir", "Seleccionar")
                    </button>
                </div>

                <div class="glass-card" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; position: relative; border-color: var(--accent-pink); box-shadow: 0 10px 30px rgba(255, 51, 102, 0.3);">
                    <span class="badge-tag badge-gold" style="position: absolute; top: 16px; right: 16px;">
                        @Lang.T("ВЫГОДНО • -30%", "POPULAR • -30%", "BELIEBT • -30%", "POPULAIRE • -30%", "POPULAR • -30%")
                    </span>
                    <div style="font-size: 1.2rem; font-weight: 800; color: var(--accent-pink);">
                        @Lang.T("3 Месяца", "3 Months", "3 Monate", "3 Mois", "3 Meses")
                    </div>
                    <div style="font-size: 2.2rem; font-weight: 900; color: #ffffff;">€20.99</div>
                    <div style="font-size: 0.85rem; color: var(--text-dim);">
                        @Lang.T("€6.99 в месяц", "€6.99 per month", "€6,99 pro Monat", "6,99 € par mois", "6.99 € al mes")
                    </div>
                    <button class="btn btn-primary" style="width: 100%; margin-top: 10px;" type="button" @onclick='() => BuyDemo("3-months", Lang.T("3 Месяца", "3 Months", "3 Monate", "3 Mois", "3 Meses"), 20.99m)'>
                        @Lang.T("Выбрать", "Select plan", "Wählen", "Choisir", "Seleccionar")
                    </button>
                </div>

                <div class="glass-card" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; position: relative;">
                    <span class="badge-tag badge-cyan" style="position: absolute; top: 16px; right: 16px;">
                        @Lang.T("МАКСИМУМ • -50%", "BEST DEAL • -50%", "BESTES ANGEBOT • -50%", "MEILLEUR PRIX • -50%", "MEJOR PRECIO • -50%")
                    </span>
                    <div style="font-size: 1.2rem; font-weight: 800; color: var(--accent-cyan);">
                        @Lang.T("12 Месяцев", "12 Months", "12 Monate", "12 Mois", "12 Meses")
                    </div>
                    <div style="font-size: 2.2rem; font-weight: 900; color: #ffffff;">€59.99</div>
                    <div style="font-size: 0.85rem; color: var(--text-dim);">
                        @Lang.T("€4.99 в месяц", "€4.99 per month", "€4,99 pro Monat", "4,99 € par mois", "4.99 € al mes")
                    </div>
                    <button class="btn btn-outline" style="width: 100%; margin-top: 10px;" type="button" @onclick='() => BuyDemo("12-months", Lang.T("12 Месяцев", "12 Months", "12 Monate", "12 Mois", "12 Meses"), 59.99m)'>
                        @Lang.T("Выбрать", "Select plan", "Wählen", "Choisir", "Seleccionar")
                    </button>
                </div>
            }
            else
            {
                @foreach (var plan in Plans)
                {
                    <div class="glass-card @(plan.Highlight ? "highlight" : "")" style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; position: relative; @(plan.Highlight ? "border-color: var(--accent-pink); box-shadow: 0 10px 30px rgba(255, 51, 102, 0.3);" : "")">
                        @if (!string.IsNullOrWhiteSpace(plan.Badge))
                        {
                            <span class="badge-tag badge-gold" style="position: absolute; top: 16px; right: 16px;">@plan.Badge</span>
                        }

                        <div style="font-size: 1.2rem; font-weight: 800; color: #ffffff;">@plan.Name</div>
                        <div style="font-size: 2.2rem; font-weight: 900; color: var(--accent-pink);">@plan.PriceLabel</div>
                        <div style="font-size: 0.85rem; color: var(--text-dim);">@plan.Period</div>

                        <button class="btn @(plan.Highlight ? "btn-primary" : "btn-outline")" style="width: 100%; margin-top: 10px;" type="button" @onclick="() => Buy(plan)">
                            @Lang.T("Купить", "Buy", "Kaufen", "Acheter", "Comprar")
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<string> CurrentBenefits =>
        Lang.Current switch
        {
            LanguageState.Language.Ru => RuBenefits,
            LanguageState.Language.En => EnBenefits,
            LanguageState.Language.De => DeBenefits,
            LanguageState.Language.Fr => FrBenefits,
            LanguageState.Language.Es => EsBenefits,
            _ => EnBenefits
        };

    private static readonly IReadOnlyList<string> RuBenefits =
    [
        "Эксклюзивные сцены и открытые финал-развязки",
        "Ежедневный бонус +50 алмазов",
        "Бесконечная энергия без ожиданий",
        "Уникальная рамка профиля и статус VIP"
    ];

    private static readonly IReadOnlyList<string> EnBenefits =
    [
        "Exclusive scenes and unlocked secret endings",
        "Daily bonus +50 diamonds",
        "Infinite energy with zero waiting time",
        "Unique avatar frame & VIP status"
    ];

    private static readonly IReadOnlyList<string> DeBenefits =
    [
        "Exklusive Szenen und freigeschaltete Enden",
        "Täglicher Bonus +50 Diamanten",
        "Unbegrenzte Energie ohne Wartezeit",
        "Einzigartiger Profilrahmen & VIP-Status"
    ];

    private static readonly IReadOnlyList<string> FrBenefits =
    [
        "Scènes exclusives et fins secrètes débloquées",
        "Bonus quotidien de +50 diamants",
        "Énergie illimitée sans attente",
        "Cadre de profil unique et statut VIP"
    ];

    private static readonly IReadOnlyList<string> EsBenefits =
    [
        "Escenas exclusivas y finales secretos desbloqueados",
        "Bonificación diaria de +50 diamantes",
        "Energía ilimitada sin tiempos de espera",
        "Marco de perfil único y estado VIP"
    ];

    private IReadOnlyList<Plan> Plans => _plans;
    private IReadOnlyList<Plan> _plans = [];

    protected override async Task OnInitializedAsync()
    {
        _plans = await LoadPlansAsync();
    }

    private void Buy(Plan plan)
    {
        Cart.AddItem($"premium:{plan.Id}", $"Premium — {plan.Name}", plan.PriceValue, 1);
    }

    private void BuyDemo(string id, string name, decimal price)
    {
        Cart.AddItem($"premium:{id}", $"Premium — {name}", price, 1);
    }

    private async Task<IReadOnlyList<Plan>> LoadPlansAsync()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<IReadOnlyList<CatalogItemDto>>(CatalogItemsUrl);
            if (items is null) return [];

            return items
                .Where(item => string.Equals(item.Type, "Subscription", StringComparison.OrdinalIgnoreCase) && item.IsActive)
                .Select(MapPlanFromCatalog)
                .Where(plan => plan is not null)
                .Select(plan => plan!)
                .OrderBy(plan => plan.Months)
                .ToList();
        }
        catch
        {
            return [];
        }
    }

    private string CatalogItemsUrl
    {
        get
        {
            var baseUrl = Config["ApiBaseUrl"]?.Trim();
            return string.IsNullOrWhiteSpace(baseUrl)
                ? "/api/v1/catalog/items"
                : $"{baseUrl.TrimEnd('/')}/api/v1/catalog/items";
        }
    }

    private Plan? MapPlanFromCatalog(CatalogItemDto item)
    {
        if (!item.Metadata.TryGetValue("months", out var monthsText) || !int.TryParse(monthsText, out var months))
        {
            return null;
        }

        var badgeKey = GetMetadataValue(item.Metadata, "badgeKey");
        var badgeKind = GetBadgeKindFromMetadata(item.Metadata);

        return new Plan(
            item.Id,
            months,
            FormatMonths(months),
            item.Price,
            $"€{item.Price:0.00}",
            FormatBillingPeriod(months),
            GetBadgeText(badgeKey),
            string.Equals(badgeKind, "gold", StringComparison.OrdinalIgnoreCase));
    }

    private string FormatMonths(int months) => Lang.Current switch
    {
        LanguageState.Language.Ru => $"{months} {GetRuMonthsWord(months)}",
        LanguageState.Language.En => $"{months} month{(months == 1 ? string.Empty : "s")}",
        LanguageState.Language.De => $"{months} Monat{(months == 1 ? string.Empty : "e")}",
        LanguageState.Language.Fr => $"{months} mois",
        LanguageState.Language.Es => $"{months} mes{(months == 1 ? string.Empty : "es")}",
        _ => $"{months} months"
    };

    private string FormatBillingPeriod(int months) => months switch
    {
        1 => Lang.T("Ежемесячно", "Monthly", "Monatlich", "Mensuel", "Mensual"),
        12 => Lang.T("Раз в год", "Yearly", "Jährlich", "Annuel", "Anual"),
        _ => string.Format(
            Lang.T("Раз в {0} месяца", "Every {0} months", "Alle {0} Monate", "Tous les {0} mois", "Cada {0} meses"),
            months)
    };

    private string? GetBadgeText(string? badgeKey) => badgeKey switch
    {
        "best" => Lang.T("Выгодно", "Best deal", "Bestes Angebot", "Meilleure offre", "Mejor oferta"),
        "top" => Lang.T("Топ", "Top", "Top", "Top", "Top"),
        "hot" => Lang.T("Хит", "Hot", "Hot", "Hot", "Hot"),
        "mega" => Lang.T("Мега", "Mega", "Mega", "Mega", "Mega"),
        _ => null
    };

    private static string? GetBadgeKindFromMetadata(IReadOnlyDictionary<string, string> metadata)
    {
        var value = GetMetadataValue(metadata, "badgeKind")?.ToLowerInvariant();
        return value is "gold" or "purple" ? value : null;
    }

    private static string? GetMetadataValue(IReadOnlyDictionary<string, string> metadata, string key) =>
        metadata.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value)
            ? value
            : null;

    private static string GetRuMonthsWord(int months)
    {
        var n = months % 100;
        if (n is >= 11 and <= 14) return "месяцев";
        var lastDigit = months % 10;
        if (lastDigit == 1) return "месяц";
        if (lastDigit is 2 or 3 or 4) return "месяца";
        return "месяцев";
    }

    private sealed record Plan(Guid Id, int Months, string Name, decimal PriceValue, string PriceLabel, string Period, string? Badge, bool Highlight);

    private sealed record CatalogItemDto(
        Guid Id,
        string Title,
        string Description,
        string Type,
        decimal Price,
        string Currency,
        bool IsActive,
        Dictionary<string, string> Metadata,
        string? ImageUrl);
}
