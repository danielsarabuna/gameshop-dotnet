@page "/subscription"
@inject CartState Cart
@inject LanguageState Lang
@inject HttpClient Http
@inject IConfiguration Config

<PageTitle>GameShop — @Lang.T("Подписка", "Subscription", "Abo", "Abonnement", "Suscripción")</PageTitle>

<section class="page-pad">
    <div class="container">
        <div class="two-col">
            <div>
                <h1>Premium</h1>
                <p class="muted">
                    @Lang.T(
                        "Premium открывает дополнительные сцены, ускоряет прогресс и даёт доступ к эксклюзивным активностям. Подписка продлевается по выбранному сроку.",
                        "Premium unlocks extra scenes, speeds up progression, and gives access to exclusive activities. Your subscription runs for the selected period.",
                        "Premium schaltet zusätzliche Szenen frei, beschleunigt den Fortschritt und bietet exklusive Aktivitäten. Das Abo läuft für den gewählten Zeitraum.",
                        "Premium débloque des scènes supplémentaires, accélère la progression et donne accès à des activités exclusives. L’abonnement dure la période choisie.",
                        "Premium desbloquea escenas extra, acelera el progreso y da acceso a actividades exclusivas. La suscripción dura el período seleccionado."
                    )
                </p>

                <div class="benefits">
                    @foreach (var benefit in CurrentBenefits)
                    {
                        <div class="benefit">
                            <span class="check" aria-hidden="true">@((MarkupString)Icons.Check)</span>
                            <span>@benefit</span>
                        </div>
                    }
                </div>
            </div>

            <div>
                <div class="gif-slot gif-premium">
                    <object class="gif-media" data="gifs/premium-content.gif" type="image/gif">
                        <div class="gif gif-premium">premium-content.gif</div>
                    </object>
                </div>
            </div>
        </div>

        <div class="plans">
            <div class="centered">
                @if (Plans.Count == 0)
                {
                    <h2>@Lang.T("Планы временно недоступны", "Plans are temporarily unavailable", "Pläne sind vorübergehend nicht verfügbar", "Les forfaits sont temporairement indisponibles", "Los planes no están disponibles temporalmente")</h2>
                    <p class="muted">@Lang.T("Мы не получили подписки из каталога. Обновите страницу чуть позже.", "We could not load subscription plans from catalog. Please refresh the page a bit later.", "Wir konnten die Abopläne aus dem Katalog nicht laden. Bitte aktualisiere die Seite später erneut.", "Nous n'avons pas pu charger les forfaits depuis le catalogue. Veuillez actualiser la page un peu plus tard.", "No pudimos cargar los planes desde el catálogo. Actualiza la página un poco más tarde.")</p>
                }
                else
                {
                    <h2>@Lang.T("Выберите план", "Choose a plan", "Wähle einen Plan", "Choisir un plan", "Elige un plan")</h2>
                }
            </div>

            @if (Plans.Count > 0)
            {
                <div class="plan-row">
                    @foreach (var plan in Plans)
                    {
                        <div class="card plan-card @(plan.Highlight ? "highlight" : "")">
                            @if (!string.IsNullOrWhiteSpace(plan.Badge))
                            {
                                <div class="card-badge badge-gold">@plan.Badge</div>
                            }

                            <div class="plan-name">@plan.Name</div>
                            <p class="plan-price">@plan.PriceLabel</p>
                            <div class="plan-period">@plan.Period</div>

                            <button class="btn btn-primary" style="width: 100%;" type="button" @onclick="() => Buy(plan)">
                                @Lang.T("Купить", "Buy", "Kaufen", "Acheter", "Comprar")
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private IReadOnlyList<string> CurrentBenefits =>
        Lang.Current switch
        {
            LanguageState.Language.Ru => RuBenefits,
            LanguageState.Language.En => EnBenefits,
            LanguageState.Language.De => DeBenefits,
            LanguageState.Language.Fr => FrBenefits,
            LanguageState.Language.Es => EsBenefits,
            _ => EnBenefits
        };

    private static readonly IReadOnlyList<string> RuBenefits =
    [
        "Эксклюзивные сцены и диалоги",
        "Бонусные алмазы каждый день",
        "Ускоренное восстановление энергии",
        "Уникальные предметы кастомизации"
    ];

    private static readonly IReadOnlyList<string> EnBenefits =
    [
        "Exclusive scenes and dialogues",
        "Daily bonus diamonds",
        "Faster energy recovery",
        "Unique customization items"
    ];

    private static readonly IReadOnlyList<string> DeBenefits =
    [
        "Exklusive Szenen und Dialoge",
        "Tägliche Bonus‑Diamanten",
        "Schnellere Energie‑Regeneration",
        "Einzigartige Anpassungs‑Items"
    ];

    private static readonly IReadOnlyList<string> FrBenefits =
    [
        "Scènes et dialogues exclusifs",
        "Diamants bonus quotidiens",
        "Récupération d’énergie plus rapide",
        "Objets de personnalisation uniques"
    ];

    private static readonly IReadOnlyList<string> EsBenefits =
    [
        "Escenas y diálogos exclusivos",
        "Diamantes extra diarios",
        "Recuperación de energía más rápida",
        "Objetos de personalización únicos"
    ];
    private IReadOnlyList<Plan> Plans => _plans;
    private IReadOnlyList<Plan> _plans = [];

    protected override async Task OnInitializedAsync()
    {
        _plans = await LoadPlansAsync();
    }

    private void Buy(Plan plan)
    {
        Cart.AddItem($"premium:{plan.Id}", $"Premium — {plan.Name}", plan.PriceValue, 1);
    }

    private async Task<IReadOnlyList<Plan>> LoadPlansAsync()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<IReadOnlyList<CatalogItemDto>>(CatalogItemsUrl);
            if (items is null)
            {
                return [];
            }

            return items
                .Where(item => string.Equals(item.Type, "Subscription", StringComparison.OrdinalIgnoreCase) && item.IsActive)
                .Select(MapPlanFromCatalog)
                .Where(plan => plan is not null)
                .Select(plan => plan!)
                .OrderBy(plan => plan.Months)
                .ToList();
        }
        catch
        {
            return [];
        }
    }

    private string CatalogItemsUrl
    {
        get
        {
            var baseUrl = Config["ApiBaseUrl"]?.Trim();
            return string.IsNullOrWhiteSpace(baseUrl)
                ? "/api/v1/catalog/items"
                : $"{baseUrl.TrimEnd('/')}/api/v1/catalog/items";
        }
    }

    private Plan? MapPlanFromCatalog(CatalogItemDto item)
    {
        if (!item.Metadata.TryGetValue("months", out var monthsText) || !int.TryParse(monthsText, out var months))
        {
            return null;
        }

        var badgeKey = GetMetadataValue(item.Metadata, "badgeKey");
        var badgeKind = GetBadgeKindFromMetadata(item.Metadata);

        return new Plan(
            item.Id,
            months,
            FormatMonths(months),
            item.Price,
            $"€{item.Price:0.00}",
            FormatBillingPeriod(months),
            GetBadgeText(badgeKey),
            string.Equals(badgeKind, "gold", StringComparison.OrdinalIgnoreCase));
    }

    private string FormatMonths(int months) => Lang.Current switch
    {
        LanguageState.Language.Ru => $"{months} {GetRuMonthsWord(months)}",
        LanguageState.Language.En => $"{months} month{(months == 1 ? string.Empty : "s")}",
        LanguageState.Language.De => $"{months} Monat{(months == 1 ? string.Empty : "e")}",
        LanguageState.Language.Fr => $"{months} mois",
        LanguageState.Language.Es => $"{months} mes{(months == 1 ? string.Empty : "es")}",
        _ => $"{months} months"
    };

    private string FormatBillingPeriod(int months) => months switch
    {
        1 => Lang.T("Ежемесячно", "Monthly", "Monatlich", "Mensuel", "Mensual"),
        12 => Lang.T("Раз в год", "Yearly", "Jährlich", "Annuel", "Anual"),
        _ => string.Format(
            Lang.T("Раз в {0} месяца", "Every {0} months", "Alle {0} Monate", "Tous les {0} mois", "Cada {0} meses"),
            months)
    };

    private string? GetBadgeText(string? badgeKey) => badgeKey switch
    {
        "best" => Lang.T("Выгодно", "Best deal", "Bestes Angebot", "Meilleure offre", "Mejor oferta"),
        "top" => Lang.T("Топ", "Top", "Top", "Top", "Top"),
        "hot" => Lang.T("Хит", "Hot", "Hot", "Hot", "Hot"),
        "mega" => Lang.T("Мега", "Mega", "Mega", "Mega", "Mega"),
        _ => null
    };

    private static string? GetBadgeKindFromMetadata(IReadOnlyDictionary<string, string> metadata)
    {
        var value = GetMetadataValue(metadata, "badgeKind")?.ToLowerInvariant();
        return value is "gold" or "purple" ? value : null;
    }

    private static string? GetMetadataValue(IReadOnlyDictionary<string, string> metadata, string key) =>
        metadata.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value)
            ? value
            : null;

    private static string GetRuMonthsWord(int months)
    {
        var n = months % 100;
        if (n is >= 11 and <= 14)
        {
            return "месяцев";
        }

        var lastDigit = months % 10;
        if (lastDigit == 1)
        {
            return "месяц";
        }

        if (lastDigit == 2 || lastDigit == 3 || lastDigit == 4)
        {
            return "месяца";
        }

        return "месяцев";
    }

    private sealed record Plan(Guid Id, int Months, string Name, decimal PriceValue, string PriceLabel, string Period, string? Badge, bool Highlight);

    private sealed record CatalogItemDto(
        Guid Id,
        string Title,
        string Description,
        string Type,
        decimal Price,
        string Currency,
        bool IsActive,
        Dictionary<string, string> Metadata,
        string? ImageUrl);

    private static class Icons
    {
        public const string Check =
            "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M20 6 9 17l-5-5' stroke='currentColor' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/></svg>";
    }
}
